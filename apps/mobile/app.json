{
  "expo": {
    "name": "Llah",
    "slug": "llah",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f6f9fc"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.llah.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f6f9fc"
      },
      "package": "com.llah.mobile"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
